--- !u!114 &264236016
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 264236014}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 62c2b597fb319594cbe6fdbf97d17fe6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - 'That ship smashed straight through the observation glass. Whatever was on board
    got into the station...

    After the collision, it seems the station systems
    are down.

    I would restore them myself but the impact broke my leg, can you
    restore the systems?

    Take the Intel Keycard from my desk, then talk to me
    again.'
  - "If you have the Intel Keycard head into the Command Center and check the screens.
    \nIf System Life Supprt is down, you\u2019ll need Medical sector access.\nFind
    the Doctor and access the Medical sector."
  canRepeatLastLine: 1
  dialogueUI: {fileID: 306550355}
  typeSpeed: 0.05
  animator: {fileID: 264236017}
  talkingBoolName: isTalking
  player: {fileID: 2058105707}
  npcWalker: {fileID: 0}
  walkAfterFirstDialogue: 0
