  m_Script: {fileID: 11500000, guid: 62c2b597fb319594cbe6fdbf97d17fe6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - 'You''re the new guy, right?

    Ever since the power outage last night, my
    head has felt a little off.

    You''re gonna have to take over my shift. I
    left my keycard in my locker in the Crew Storage.

    Oh yeah, and don''t forget
    to stop by the Gun Range and grab a weapon, standard protocol. '
